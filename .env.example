# İsteğe bağlı ayarlar. Kullanmak için bu dosyayı .env olarak kopyalayın.

# Ollama adresi ve modeller
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:4b-instruct
# OLLAMA_EMBED_MODEL=bge-m3
# OLLAMA_KEEP_ALIVE=30m

# rag  : her soruda ilgili 3 SSS maddesi sistem mesajına girer (8 GB RAM için önerilen)
# full : tüm SSS sistem mesajına girer (16 GB+ RAM; ilk açılış uzun sürer)
# FAQ_MODE=rag
# FAQ_TOP_K=3

# PORT=3000
# ALLOWED_ORIGINS=https://ispark.istanbul
